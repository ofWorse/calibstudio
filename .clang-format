# CalibStudio code style. Qt Creator applies it on save when
# "Beautifier > ClangFormat > Use file .clang-format" is on; from a shell:
#   clang-format -i $(git ls-files 'src/*.cpp' 'src/*.h')
#
#   if(condition)          no space before "(" after if / for / while / switch
#   {                      braces on their own line, always present
#       ...
#   }
#
#   class Name             private data members first (no m_ prefix),
#   {                      then public methods, then private methods
#   private:
#       int member = 0;
#   public:
#       void method(void);
#   private:
#       void helper(void);
#   };
Language: Cpp
BasedOnStyle: LLVM
Standard: c++17
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120
AccessModifierOffset: -4
IndentCaseLabels: false
NamespaceIndentation: None
IndentPPDirectives: None
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false
SpaceBeforeParens: Never
SpaceAfterTemplateKeyword: true
SpaceBeforeCpp11BracedList: false
Cpp11BracedListStyle: true
InsertBraces: true
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterExternBlock: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: true
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: All
AllowShortCaseLabelsOnASingleLine: true
AlignConsecutiveShortCaseStatements:
  Enabled: true
AlignTrailingComments:
  Kind: Leave
AlignAfterOpenBracket: Align
AlignOperands: DontAlign
AlignArrayOfStructures: Left
BreakConstructorInitializers: BeforeColon
ConstructorInitializerIndentWidth: 4
PackConstructorInitializers: Never
BreakBeforeBinaryOperators: NonAssignment
AlwaysBreakTemplateDeclarations: Yes
EmptyLineBeforeAccessModifier: LogicalBlock
EmptyLineAfterAccessModifier: Never
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 2
FixNamespaceComments: true
ShortNamespaceLines: 0
SortIncludes: Never
ReflowComments: false
SpacesBeforeTrailingComments: 1
LambdaBodyIndentation: Signature
PenaltyBreakAssignment: 100
PenaltyReturnTypeOnItsOwnLine: 1000
BinPackArguments: true
BinPackParameters: true
